# Serving and TLS for published sites. Based on a configuration verified on
# caddy:2.11.9 (openspec/changes/stage-1-core/reference); see design §15
# before changing anything here: several details below are load-bearing.
#
# Environment (set by docker-compose.yml):
#   ACME_EMAIL          ACME account email
#   API_HOST            public API host; computed in compose because a nested
#                       default such as {$API_HOST:api.{$BASE_DOMAIN}} is not
#                       expanded by the Caddyfile adapter
#   CADDY_GLOBAL_EXTRA  extra global options (local dev: local_certs and
#                       skip_install_trust); empty in production
#   TLS_MODE            ondemand (default) or wildcard; selects the snippet
#                       tls_<mode> below, so switching needs no edit here
#   BASE_DOMAIN         base domain (wildcard mode only)
#   TLS_DNS_PROVIDER    DNS provider for the wildcard certificate (wildcard
#                       mode only, default cloudflare); selects dns_<provider>
#   CF_API_TOKEN        Cloudflare API token with Zone.DNS:Edit (read at run
#                       time through {env.*}, never written into the config)
{
	email {$ACME_EMAIL}
	# No admin API and no autosave: the root filesystem is read-only and
	# nothing needs to reconfigure Caddy at runtime.
	admin off
	persist_config off
	{$CADDY_GLOBAL_EXTRA}

	# Certificate permission is answered by Caddy itself (the listener below),
	# never by control: Caddy also calls "ask" when loading an already issued
	# certificate from storage, so depending on control would break handshakes
	# after a Caddy restart while control is down.
	on_demand_tls {
		ask http://127.0.0.1:8090/
	}

	log {
		output stdout
		format json
	}
	# Access log of published sites, also on stdout for operations. The site
	# block below names its logger "sites" so it can write the statistics
	# file too; the adapter then excludes that logger from the default one,
	# and a catch-all site block can carry only one logger name.
	log sites_stdout {
		output stdout
		format json
		include http.log.access.sites
	}

	servers {
		# A Host header that differs from the TLS SNI name gets 421, so one
		# site's certificate cannot be used to fetch another site's files.
		strict_sni_host on
		# Slow-header clients are cut off and idle keep-alive connections are
		# closed. read_body is deliberately unset: archive uploads to the API
		# may stream tens of megabytes over slow links (control bounds them).
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(security_headers) {
	header X-Content-Type-Options nosniff
}

(plain_error) {
	header Cache-Control no-store
	respond "{err.status_code} {err.status_text}" {err.status_code}
}

# On-demand TLS permission endpoint, reachable only from inside this
# container (bind 127.0.0.1). A name is allowed if /data/by-host/<name>/
# exists and resolves to a directory.
# - The regexp is mandatory: ".." and "%2e%2e" collapse to /data/by-host/
#   itself and would otherwise be allowed. It is the @site expression below
#   without the port. IP addresses pass the regexp but have no by-host entry.
# - The trailing "/" in try_files is mandatory: without it the matcher accepts
#   only regular files, and by-host entries are symlinks to directories.
http://127.0.0.1:8090 {
	bind 127.0.0.1
	@allowed {
		vars_regexp {query.domain} ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$
		file {
			root /data/by-host
			try_files {query.domain}/
		}
	}
	respond @allowed 200
	respond 404
}

{$API_HOST} {
	import security_headers
	log
	reverse_proxy control:8080
	handle_errors {
		import security_headers
		import plain_error
	}
}

http:// {
	import security_headers
	log
	redir https://{host}{uri} 308
}

# Everything a site address serves. Shared by the on-demand catch-all and, in
# wildcard mode, by the *.<BASE_DOMAIN> block, so both behave identically.
(serve_sites) {
	# Access log "sites" feeds visit statistics (control reads /logs
	# read-only); the global "sites_stdout" logger copies it to stdout.
	# Rotated files stay uncompressed so control can finish a file after
	# rotation, and mode 0644 lets control (uid 65532) read what caddy
	# (uid 1000) writes. Every block importing this snippet shares the file.
	log sites {
		output file /logs/sites-access.log {
			roll_size 50MiB
			roll_keep 5
			roll_uncompressed
			mode 0644
		}
		format json
	}
	import security_headers

	# The site directory is taken from this regexp group, not from {host}:
	# {host} is empty for an HTTP/1.0 request without Host (root would become
	# /data/by-host/ and expose other sites), and it keeps upper case and a
	# trailing dot. Only lower-case DNS labels with an optional port match.
	@site header_regexp site Host ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*)(:[0-9]{1,5})?$
	# Any path segment starting with a dot is hidden, except plain entries
	# under /.well-known/. "hide .*" is not used: file matchers ignore it and
	# it would also hide /.well-known/.
	@hidden {
		path_regexp /\.
		not path_regexp ^/\.well-known(/[^./][^/]*)*/?$
	}
	# Paths reserved for the platform; other /_* paths (e.g. /_next/) are
	# ordinary site files. /_dropsite/* is served by control (visitor login of
	# protected sites, the Altcha widget script); of /_form/* only the routes
	# below reach control, the rest answers 404.
	@reserved path /_form /_form/*
	@platform path /_dropsite /_dropsite/*

	# Per-host flags: control creates and removes marker files, Caddy only
	# checks them (no reload). Without a trailing "/" try_files matches
	# regular files only. {re.site.1} is set inside "handle @site".
	@noindex file {
		root /data/flags/noindex
		try_files /{re.site.1}
	}
	@protected file {
		root /data/flags/protected
		try_files /{re.site.1}
	}

	# Release preview addresses (wildcard mode, see internal/domain
	# PreviewLabel) are never indexed. The pattern cannot match a slug:
	# slug validation rejects it.
	@preview header_regexp Host ^p-[0-9]{8}-[0-9]{6}-[a-z0-9]{6}-[a-z0-9]{10}\.
	header @preview X-Robots-Tag noindex

	handle @site {
		root * /data/by-host/{re.site.1}

		# The explicit route keeps directives in the written order. Without it
		# Caddy sorts "header" before "rewrite", and clean URLs would get the
		# asset Cache-Control instead of no-cache.
		route {
			# STAGE2-FLAGS
			# The login page comes first: it must be reachable without access.
			# Its own X-Robots-Tag is dropped and set here, so the header is
			# never doubled with the @preview/@noindex ones.
			header @platform X-Robots-Tag "noindex, nofollow"
			reverse_proxy @platform control:8080 {
				header_down -X-Robots-Tag
			}

			# Set before anything answers, so redirects, the login redirect
			# and files all carry it. "header" replaces the @preview value.
			header @noindex X-Robots-Tag "noindex, nofollow"

			# Open sites never reach control. For protected ones control
			# answers 2xx (serve), 302 to the login page, or an error; if it
			# is down the proxy error ends in handle_errors (503 page), so
			# nothing of the site is served: 404.html and 200.html are below.
			forward_auth @protected control:8081 {
				uri /internal/auth-check
			}

			# Site forms: control answers POST /_form/<name> and the Altcha
			# challenge (the widget script is /_dropsite/altcha.js above).
			# Every other /_form request is 404 below. Form bodies are capped
			# here too (control enforces the same 64 KiB). After forward_auth
			# on purpose: a protected site accepts forms only from visitors
			# who signed in to it.
			@formPost {
				method POST
				path /_form/*
			}
			@formChallenge {
				method GET HEAD
				path /_form/challenge
			}
			request_body @formPost {
				max_size 64KiB
			}
			reverse_proxy @formPost control:8080
			reverse_proxy @formChallenge control:8080

			error @hidden 404
			error @reserved 404

			# Files generated at publish time live in /.dropsite/ (hidden above,
			# so only these rewrites reach it). Fallbacks are served only where
			# the site has no file of its own; they come before clean URLs and
			# the SPA fallback so 200.html does not answer /robots.txt.
			@generated {
				path /robots.txt /sitemap.xml /favicon.ico
				not file {path}
				file /.dropsite/static{path}
			}
			rewrite @generated /.dropsite/static{path}

			# WebP variants of JPEG and PNG images, same size in pixels, only
			# for clients that accept WebP; Vary keeps shared caches correct.
			@webpVariant {
				path *.jpg *.jpeg *.png
				file /.dropsite/webp{path}.webp
			}
			header @webpVariant Vary Accept
			@webpAccepted {
				path *.jpg *.jpeg *.png
				header Accept *image/webp*
				file /.dropsite/webp{path}.webp
			}
			rewrite @webpAccepted /.dropsite/webp{path}.webp

			@cleanurl {
				not file {path}
				file {path}.html
			}
			rewrite @cleanurl {path}.html

			@spa {
				not file {path} {path}/index.html
				file /200.html
			}
			rewrite @spa /200.html

			# Chosen by the path after rewrites, not by Content-Type: a 304
			# response has no Content-Type.
			@html path / */ *.html *.htm
			header @html Cache-Control no-cache
			@asset not path / */ *.html *.htm
			header @asset Cache-Control "public, max-age=3600"

			encode zstd gzip
			file_server
		}
	}

	handle {
		error 404
	}

	handle_errors {
		import security_headers

		handle @site {
			# root must be its own directive before the file matcher below.
			root * /data/by-host/{re.site.1}
			header @noindex X-Robots-Tag "noindex, nofollow"

			# 5xx on a site address comes only from the proxies above, that
			# is, control is unreachable: a protected site fails closed.
			@unavailable expression {err.status_code} in [502, 503, 504]
			handle @unavailable {
				header Cache-Control no-store
				header Content-Type "text/html; charset=utf-8"
				header Retry-After 30
				respond `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Temporarily unavailable</title></head><body><main><h1>Temporarily unavailable</h1><p>This site cannot be opened right now. Please try again in a minute.</p><p lang="ru">Сайт временно недоступен. Попробуйте открыть его через минуту.</p></main></body></html>` 503
			}

			@custom404 {
				expression {err.status_code} == 404
				file /404.html
			}
			handle @custom404 {
				rewrite * /404.html
				header Cache-Control no-cache
				encode zstd gzip
				file_server {
					status 404
				}
			}

			handle {
				import plain_error
			}
		}

		handle {
			import plain_error
		}
	}
}

# Sites under the base domain in wildcard mode: one certificate for
# *.<BASE_DOMAIN> and <BASE_DOMAIN> through the DNS-01 challenge. Names outside
# the base domain still match the on-demand catch-all below.
#
# A snippet is parsed only when imported, so the stock caddy image (without DNS
# plugins) accepts this file in ondemand mode. An unknown TLS_MODE fails at
# startup: "import tls_<mode>" then looks for a file and finds none.
(tls_ondemand) {
	# Nothing to add: every site address uses the on-demand catch-all.
}

(tls_wildcard) {
	*.{$BASE_DOMAIN}, {$BASE_DOMAIN} {
		tls {
			import dns_{$TLS_DNS_PROVIDER:cloudflare}
		}
		import serve_sites
	}
}

# DNS providers for the wildcard certificate. Each needs its plugin in the
# caddy image (deploy/caddy/Dockerfile). "internal" signs the wildcard with
# Caddy's local CA and is meant only for local testing without real DNS.
(dns_cloudflare) {
	dns cloudflare {env.CF_API_TOKEN}
}

(dns_internal) {
	issuer internal
}

import tls_{$TLS_MODE:ondemand}

# Any other name (external domains; every site address in ondemand mode) gets
# its own certificate on first visit, permitted by the endpoint on :8090.
https:// {
	tls {
		on_demand
	}
	import serve_sites
}
