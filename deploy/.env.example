# dropsite configuration. Copy to .env next to docker-compose.yml and fill in
# the four required variables. Empty optional variables use the defaults.

# --- Required -------------------------------------------------------------

# Base domain for sites: each site gets <id>.<BASE_DOMAIN> (and <slug>.<BASE_DOMAIN>).
# Point *.<BASE_DOMAIN> at this server. Use a dedicated domain that hosts no
# other services of your company: anyone with an account publishes under it.
BASE_DOMAIN=

# Email of the ACME (Let's Encrypt) account used to issue certificates.
ACME_EMAIL=

# Login of the first administrator, created on the first start only.
ADMIN_EMAIL=

# Password of the first administrator, used on the first start only.
# Change it in the UI afterwards; later changes here have no effect.
ADMIN_PASSWORD=

# --- Optional -------------------------------------------------------------

# IP address the admin web UI (port 8082) is published on. Default 127.0.0.1:
# reach it through an SSH tunnel or set a private/VPN address.
ADMIN_BIND_IP=

# Public URL of the admin UI, used in links. Default http://<ADMIN_BIND_IP>:8082.
UI_URL=

# Host of the public API and MCP endpoint. Default api.<BASE_DOMAIN>.
API_HOST=

# Certificate mode: ondemand (one certificate per site address, issued on the
# first visit). wildcard is reserved for a later version. Default ondemand.
TLS_MODE=

# Limits. Sizes accept plain bytes or KB/MB/GB (decimal), KiB/MiB/GiB (binary).
# Values set by an administrator in the UI take precedence over these.
# Maximum unpacked size of one release. Default 50MiB.
MAX_SITE_BYTES=
# Maximum size of one file. Default 20MiB.
MAX_FILE_BYTES=
# Maximum number of files in one release. Default 2000.
MAX_FILES=
# Maximum number of sites per user. Default 10.
MAX_SITES_PER_USER=
# Number of releases kept per site, at least 2. Default 5.
KEEP_RELEASES=

# Extra forbidden slugs, comma-separated (e.g. mail,shop). Default empty.
RESERVED_SLUGS=

# How often control reads the sites access log for visit statistics
# (Go duration, 1s to 1h). Default 1m.
STATS_INTERVAL=

# Log level: debug, info, warn or error. Default info.
LOG_LEVEL=

# Version tag of the control image. Default latest.
DROPSITE_VERSION=

# Extra Caddy global options (advanced). Leave empty in production.
CADDY_GLOBAL_EXTRA=
