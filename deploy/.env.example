# dropsite configuration. Copy to .env next to docker-compose.yml and fill in
# the four required variables. Empty optional variables use the defaults.

# --- Required -------------------------------------------------------------

# Base domain for sites: each site gets <id>.<BASE_DOMAIN> (and <slug>.<BASE_DOMAIN>).
# Point *.<BASE_DOMAIN> at this server. Use a dedicated domain that hosts no
# other services of your company: anyone with an account publishes under it.
BASE_DOMAIN=

# Email of the ACME (Let's Encrypt) account used to issue certificates.
ACME_EMAIL=

# Login of the first administrator, created on the first start only.
ADMIN_EMAIL=

# Password of the first administrator, used on the first start only.
# Change it in the UI afterwards; later changes here have no effect.
ADMIN_PASSWORD=

# --- Optional -------------------------------------------------------------

# IP address the admin web UI (port 8082) is published on. Default 127.0.0.1:
# reach it through an SSH tunnel or set a private/VPN address.
ADMIN_BIND_IP=

# Public URL of the admin UI, used in links. Default http://<ADMIN_BIND_IP>:8082.
UI_URL=

# Host of the public API and MCP endpoint. Default api.<BASE_DOMAIN>.
API_HOST=

# Certificate mode. Leave empty for ondemand: one certificate per site address,
# issued on the first visit (Let's Encrypt allows about 50 new ones a week).
# For wildcard mode do not set it here: start with compose.wildcard.yml, which
# sets it for both containers (docs/tls.md).
TLS_MODE=

# Wildcard mode only (compose.wildcard.yml). Cloudflare API token with
# Zone.DNS:Edit on the zone of BASE_DOMAIN; passed to Caddy only.
CF_API_TOKEN=
# DNS provider snippet of the Caddyfile. Default cloudflare.
TLS_DNS_PROVIDER=

# Limits. Sizes accept plain bytes or KB/MB/GB (decimal), KiB/MiB/GiB (binary).
# Values set by an administrator in the UI take precedence over these.
# Maximum unpacked size of one release. Default 50MiB.
MAX_SITE_BYTES=
# Maximum size of one file. Default 20MiB.
MAX_FILE_BYTES=
# Maximum number of files in one release. Default 2000.
MAX_FILES=
# Maximum number of sites per user. Default 10.
MAX_SITES_PER_USER=
# Number of releases kept per site, at least 2. Default 5.
KEEP_RELEASES=

# Extra forbidden slugs, comma-separated (e.g. mail,shop). Default empty.
RESERVED_SLUGS=

# External domains (docs/external-domains.md). Maximum number of own domains
# per site, 1-100. Default 5.
MAX_DOMAINS_PER_SITE=
# Public IP addresses of this server, comma-separated (e.g. 203.0.113.7,2001:db8::7).
# Shown to site owners as the A/AAAA target and used by the administrator's
# DNS check. Default empty: the addresses BASE_DOMAIN and API_HOST resolve to.
SERVER_IPS=
# How often control reads the sites access log for visit statistics
# (Go duration, 1s to 1h). Default 1m.
STATS_INTERVAL=

# Site forms (docs/forms.md). The Telegram bot token and SMTP server are set
# by an administrator in the web interface, not here.
# Bot API base URL, only for a proxy or tests. Default https://api.telegram.org.
TELEGRAM_API_URL=
# Private networks (CIDR, comma-separated) form webhooks may reach, plain
# http allowed there. Only for test stacks; leave empty in production:
# EVERY user can then send webhooks into these networks (other containers,
# the Docker host, your LAN). Addresses of the control host itself are
# always refused.
FORM_WEBHOOK_ALLOW_CIDRS=

# Screenshots of sites (docs/screenshots.md). To enable, set
# COMPOSE_PROFILES=renderer and RENDERER_URL=http://renderer:3000.
COMPOSE_PROFILES=
RENDERER_URL=
# Address of control as the renderer reaches it. Default http://control:8083.
RENDER_BASE_URL=

# Log level: debug, info, warn or error. Default info.
LOG_LEVEL=

# Version label embedded in the locally built control binary. Default dev.
# This does not select a release: git checkout / git pull selects the source.
DROPSITE_VERSION=

# Extra Caddy global options (advanced). Leave empty in production.
CADDY_GLOBAL_EXTRA=
