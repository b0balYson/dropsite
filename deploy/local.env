# Local development values (not secrets). Used with compose.local.yml:
#   docker compose -f deploy/docker-compose.yml -f deploy/compose.local.yml \
#     --env-file deploy/local.env up -d --build
#
# *.dropsite.localhost resolves to 127.0.0.1 in browsers and curl without any
# DNS setup (RFC 6761), so every site address works out of the box.
BASE_DOMAIN=dropsite.localhost
ACME_EMAIL=dev@dropsite.localhost
ADMIN_EMAIL=admin@dropsite.localhost
ADMIN_PASSWORD=local-dev-password
ADMIN_BIND_IP=127.0.0.1
UI_URL=http://127.0.0.1:18082
SITES_HTTPS_PORT=18443
LOG_LEVEL=debug
# External domains such as promo.external.localhost resolve to this machine.
SERVER_IPS=127.0.0.1
DROPSITE_VERSION=dev
# Certificates from Caddy's internal CA instead of ACME; the CA is not
# installed into any trust store (use curl -k or accept the warning).
CADDY_GLOBAL_EXTRA="local_certs
skip_install_trust"
